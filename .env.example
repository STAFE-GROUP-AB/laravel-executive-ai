APP_NAME="Laravel Executive AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ADR-002 D1/D2: the `local` backend profile. One SQLite file in WAL mode holds the
# application tables, jobs, cache and sessions. The path is relative to the repository
# root and the file is created on boot. No MySQL or Redis is required.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ADR-002 D1: backend profile. `local` (SQLite + database queue) is the only
# profile the installer produces; `server` (MySQL + Redis) is operator-run.
LEA_BACKEND_PROFILE=local

# Blueprint §4/§10: LOCAL_ONLY, EU_RESTRICTED or CUSTOM. Shown in the menu bar.
LEA_PRIVACY_MODE=LOCAL_ONLY

# The adapter selected in SELECT_AI, empty until the owner chooses one. Never a key.
LEA_AI_PROVIDER=

# S1-02 local one-click login: with APP_ENV=local the sign-in page pre-fills the
# owner's address and verifies the one-time code without opening the mail.
# Ignored in every other environment (docs/architecture/auth.md §4).
OTP_AUTOFILL=true
