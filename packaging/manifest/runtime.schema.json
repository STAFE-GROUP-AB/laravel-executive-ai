{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://laravel-executive-ai.dev/schemas/runtime-manifest/1.json",
    "title": "Runtime release manifest (ADR-001 D4, S1-06)",
    "description": "Pins every component of one runtime version and the per-file checksums of the directory the installer copies. `package` is the exact document shipped as `runtime/<version>/manifest.json` and consumed by the Mac app's PackageVerifier; it is generated by packaging/runtime/assemble-runtime.mjs, never hand-written.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "runtime_version",
        "status",
        "built_at",
        "source_commit",
        "components",
        "signing",
        "http",
        "package",
        "artifact"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "schema_version": {
            "const": 1
        },
        "runtime_version": {
            "$ref": "#/$defs/semver"
        },
        "status": {
            "description": "unbuilt: no artefact exists for this version yet, `package` is null. built: assemble-runtime.mjs produced the directory and filled `package` (binary ad-hoc or unsigned). signed: the same directory with the Developer ID-signed binary (S1-12); `package` hashes the signed bytes.",
            "enum": [
                "unbuilt",
                "built",
                "signed"
            ]
        },
        "built_at": {
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "type": "string",
                    "format": "date-time"
                }
            ]
        },
        "source_commit": {
            "description": "Full SHA-1 of the repository commit the runtime was assembled from.",
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                }
            ]
        },
        "components": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "frankenphp",
                "php",
                "caddy",
                "static_php_cli",
                "php_extensions",
                "php_extension_libs",
                "caddy_modules",
                "caddy_modules_excluded"
            ],
            "properties": {
                "frankenphp": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "version",
                        "git_tag",
                        "repository",
                        "license"
                    ],
                    "properties": {
                        "version": {
                            "$ref": "#/$defs/semver"
                        },
                        "git_tag": {
                            "type": "string",
                            "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
                        },
                        "repository": {
                            "type": "string",
                            "format": "uri"
                        },
                        "license": {
                            "$ref": "#/$defs/admittedLicense"
                        }
                    }
                },
                "php": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "version",
                        "thread_safe",
                        "license"
                    ],
                    "properties": {
                        "version": {
                            "$ref": "#/$defs/semver"
                        },
                        "thread_safe": {
                            "const": true
                        },
                        "license": {
                            "$ref": "#/$defs/admittedLicense"
                        }
                    }
                },
                "caddy": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "version",
                        "license"
                    ],
                    "properties": {
                        "version": {
                            "$ref": "#/$defs/semver"
                        },
                        "license": {
                            "$ref": "#/$defs/admittedLicense"
                        }
                    }
                },
                "static_php_cli": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "version",
                        "git_tag",
                        "repository",
                        "license",
                        "shipped"
                    ],
                    "properties": {
                        "version": {
                            "$ref": "#/$defs/semver"
                        },
                        "git_tag": {
                            "type": "string",
                            "minLength": 1
                        },
                        "repository": {
                            "type": "string",
                            "format": "uri"
                        },
                        "license": {
                            "$ref": "#/$defs/admittedLicense"
                        },
                        "shipped": {
                            "const": false
                        }
                    }
                },
                "php_extensions": {
                    "description": "static-php-cli extension names, sorted, unique. `hash` and `pcre` are always compiled into PHP and are not listed. Anything outside ADR-001 D1 needs a new legal review (ADR-007 D2).",
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$"
                    }
                },
                "php_extension_libs": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]*$"
                    }
                },
                "caddy_modules": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/goModule"
                    }
                },
                "caddy_modules_excluded": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/goModule"
                    }
                }
            }
        },
        "signing": {
            "description": "What the signed binary must present (ADR-001 D2). `team_identifier` stays the A12 placeholder until the Apple Developer team is decided; PackageVerifier derives the real requirement from the app's own signature, so this value is documentation for S1-12 and the release checklist.",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "team_identifier",
                "identifier",
                "hardened_runtime",
                "entitlements"
            ],
            "properties": {
                "team_identifier": {
                    "type": "string",
                    "pattern": "^([A-Z0-9]{10}|LXAI_TEAM_ID)$"
                },
                "identifier": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
                },
                "hardened_runtime": {
                    "const": true
                },
                "entitlements": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "const": "com.apple.security.cs.allow-jit"
                    }
                }
            }
        },
        "http": {
            "description": "The loopback port plan preflight 6.6 uses (support matrix).",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "loopback_host",
                "preferred_port",
                "fallback_ports"
            ],
            "properties": {
                "loopback_host": {
                    "const": "127.0.0.1"
                },
                "preferred_port": {
                    "$ref": "#/$defs/port"
                },
                "fallback_ports": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "from",
                        "to"
                    ],
                    "properties": {
                        "from": {
                            "$ref": "#/$defs/port"
                        },
                        "to": {
                            "$ref": "#/$defs/port"
                        }
                    }
                }
            }
        },
        "package": {
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "$ref": "#/$defs/package"
                }
            ]
        },
        "artifact": {
            "description": "Where the signed runtime directory is published: the tarball `.github/workflows/build-runtime.yml` attached to its pre-release tag. `.github/workflows/build-macos.yml` downloads this URL, checks `sha256` and unpacks it into `Contents/Resources/runtime/` before the app is signed. null while no package is published for this version (including right after a local build, which cannot be signed).",
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "$ref": "#/$defs/artifact"
                }
            ]
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "status": {
                        "const": "unbuilt"
                    }
                }
            },
            "then": {
                "properties": {
                    "built_at": {
                        "type": "null"
                    },
                    "source_commit": {
                        "type": "null"
                    },
                    "package": {
                        "type": "null"
                    },
                    "artifact": {
                        "type": "null"
                    }
                }
            },
            "else": {
                "properties": {
                    "built_at": {
                        "type": "string"
                    },
                    "source_commit": {
                        "type": "string"
                    },
                    "package": {
                        "type": "object"
                    }
                }
            }
        }
    ],
    "$defs": {
        "semver": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "port": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
        },
        "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "artifact": {
            "description": "A published runtime package. `url` must be a GitHub release-asset URL of this repository, `sha256` the digest of the tarball at that URL, and `tag` the pre-release tag that carries it (runtime-<php>-<frankenphp>-<n>).",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "tag",
                "asset",
                "url",
                "sha256",
                "bytes"
            ],
            "properties": {
                "tag": {
                    "type": "string",
                    "pattern": "^runtime-(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-[1-9][0-9]*$"
                },
                "asset": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*\\.tar\\.gz$"
                },
                "url": {
                    "type": "string",
                    "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/download/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.tar\\.gz$"
                },
                "sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "bytes": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "goModule": {
            "type": "string",
            "pattern": "^github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
        },
        "admittedLicense": {
            "description": "ADR-007 D2.1 notice-only licenses that may ship inside the runtime.",
            "enum": [
                "MIT",
                "BSD-2-Clause",
                "BSD-3-Clause",
                "Apache-2.0",
                "ISC",
                "Zlib",
                "0BSD",
                "PHP-3.01"
            ]
        },
        "relativePath": {
            "description": "Safe relative path: no leading slash or tilde, no empty, `.` or `..` component (mirrors RuntimeManifest.isSafeRelativePath).",
            "type": "string",
            "pattern": "^(?!/|~)(?:(?!\\.\\.?(?:/|$))[^/]+)(?:/(?!\\.\\.?(?:/|$))[^/]+)*$"
        },
        "package": {
            "description": "Schema version 1 of the per-directory manifest PackageVerifier parses: exactly these four keys.",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "runtime_version",
                "executable",
                "files"
            ],
            "properties": {
                "schema_version": {
                    "const": 1
                },
                "runtime_version": {
                    "$ref": "#/$defs/semver"
                },
                "executable": {
                    "$ref": "#/$defs/relativePath"
                },
                "files": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "path",
                            "sha256",
                            "bytes"
                        ],
                        "properties": {
                            "path": {
                                "$ref": "#/$defs/relativePath"
                            },
                            "sha256": {
                                "$ref": "#/$defs/sha256"
                            },
                            "bytes": {
                                "type": "integer",
                                "minimum": 0
                            }
                        }
                    }
                }
            }
        }
    }
}
